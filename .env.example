# Copy this file to ".env" (same folder as app.py) and fill in
# your real values. ".env" should NEVER be committed to git --
# add it to .gitignore.
#
# EMAIL_PASS must be a Gmail "App Password":
# Google Account -> Security -> 2-Step Verification -> App passwords
# (Your normal Gmail password will NOT work here.)

EMAIL_USER=your.gmail.address@gmail.com
EMAIL_PASS=your16characterapppassword
